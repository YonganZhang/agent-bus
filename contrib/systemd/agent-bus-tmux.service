# Keep the Agent Bus tmux session alive (creates only an idle placeholder
# window when the session is missing; real windows come from recovery).
# Install: copy to ~/.config/systemd/user/, replace /path/to/agent-bus, then
#   systemctl --user daemon-reload && systemctl --user enable --now agent-bus-tmux.service
[Unit]
Description=Ensure the Agent Bus tmux session exists
Before=agent-bus-dashboard.service

[Service]
Type=simple
# Optional: environment files (proxy settings, PATH additions) that every new
# tmux pane should inherit, colon separated.
# Environment=AGENT_BUS_ENV_FILES=%h/.config/agent-bus/env
ExecStart=/path/to/agent-bus/contrib/boot/ensure-tmux-session
Restart=always
RestartSec=3
KillMode=process

[Install]
WantedBy=default.target
